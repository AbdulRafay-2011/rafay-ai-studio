rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isOwnerAdmin(){return signedIn() && request.auth.uid == "jMn5tWkvggTKBgW0eGZpDqmCr5F2";}
  match /users/{userId} {
   allow read: if signedIn() && (request.auth.uid == userId || isOwnerAdmin());
   allow create, update, delete: if signedIn() && request.auth.uid == userId;
   match /projects/{projectId} {
    allow read: if signedIn() && (request.auth.uid == userId || isOwnerAdmin());
    allow create, update, delete: if signedIn() && request.auth.uid == userId;
   }
  }
 }
}